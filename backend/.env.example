# --- Core -------------------------------------------------------------
# Any long random string. Signs session tokens.
APP_SECRET=
# Local: leave as is. Production: your Supabase Postgres connection string (Session pooler URI).
DATABASE_URL=sqlite:///./sidequest.db
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Optional. Protects POST /cron/tick for an external scheduler.
CRON_SECRET=
# One-click demo personas and demo controls. Keep on for judging.
DEMO_MODE=1
SEED_ON_START=1

# --- PayPal -----------------------------------------------------------
# mock: no keys, everything simulated. sandbox: real calls to api-m.sandbox.paypal.com.
# Left empty, the app picks sandbox when both keys are set, mock otherwise.
PAYPAL_MODE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From Developer Dashboard > your app > Webhooks. Needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
# Optional. A sandbox test card from Developer Dashboard > Testing tools > Card generator.
# With it, demo crowd joins create real sandbox authorizations instead of simulated ones.
DEMO_CARD_NUMBER=
DEMO_CARD_EXPIRY=2030-12
DEMO_CARD_CVV=123
# Starting fee schedule (basis points: 600 = 6%). Admins change fees on /admin after launch.
BOOKING_FEE_BPS=600
BOOKING_FEE_FIXED_CENTS=50
HOST_FEE_BPS=0

# --- Claude -----------------------------------------------------------
# Without a key the agent runs in a rule-based offline mode so the demo still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
